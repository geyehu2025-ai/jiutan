.page{padding:55rpx 32rpx}.kicker{color:#761c35;font-size:21rpx;font-weight:700;letter-spacing:2rpx}.title{margin:22rpx 0 12rpx;font-family:serif;font-size:48rpx;line-height:1.35}.price{color:#761c35;font-size:33rpx;font-weight:700}.signal{display:flex;align-items:center;gap:13rpx;margin-top:26rpx;color:#77736e;font-size:23rpx;line-height:1.5}.dot{width:13rpx;height:13rpx;border-radius:50%;background:#247058}.verify{margin-top:16rpx;padding:18rpx;border-left:4rpx solid #247058;background:#eef6f2;color:#247058;font-size:22rpx;line-height:1.5}.section-title{margin:48rpx 0 20rpx;font-size:28rpx;font-weight:700}.step{display:grid;grid-template-columns:48rpx 1fr;gap:18rpx;margin-bottom:13rpx;padding:22rpx;border-radius:16rpx;background:#efede8;font-size:24rpx;line-height:1.6}.step text{color:#761c35;font-family:serif;font-size:30rpx}.warning{margin:26rpx 0;padding:20rpx;border-left:4rpx solid #9a681e;background:#fff7e6;color:#71572e;font-size:22rpx;line-height:1.65}.primary,.secondary{margin-top:18rpx;padding:5rpx;background:#171717;color:#fff}.secondary{border:1rpx solid #171717;background:transparent;color:#171717}
